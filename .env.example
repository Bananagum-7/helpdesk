# LLM: any OpenAI-compatible endpoint.
# Direct to Groq (free key at https://console.groq.com):
HELPDESK_LLM_BASE_URL=https://api.groq.com/openai/v1
HELPDESK_LLM_API_KEY=
# ...or through the Sentinel gateway (PII redaction, injection guard, tracing):
# HELPDESK_LLM_BASE_URL=http://localhost:8000/v1
# HELPDESK_LLM_API_KEY=<SENTINEL_KEY_HELPDESK>

HELPDESK_AGENT_MODEL=llama-3.3-70b-versatile
HELPDESK_TRIAGE_MODEL=llama-3.1-8b-instant
HELPDESK_AUTO_REFUND_LIMIT=100

# Optional Langfuse tracing via LangChain callbacks
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
